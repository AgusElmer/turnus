# PostgreSQL
POSTGRES_USER=turnus
POSTGRES_PASSWORD=changeme
POSTGRES_DB=turnus

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Default=Host=db;Port=5432;Database=turnus;Username=turnus;Password=changeme
Database__SeedDemoData=true

# Google Auth (backend)
Authentication__Google__ClientId=
Authentication__Google__AllowedEmails__0=

# Frontend build
VITE_API_BASE_URL=http://localhost:8080
VITE_GOOGLE_CLIENT_ID=
# Usa "true" para evitar login en desarrollo local (no habilitar en producción)
VITE_AUTH_DISABLED=true
